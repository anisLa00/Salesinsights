# ─────────────────────────────────────────────────────────────
# Sales Insight — environment configuration
# Copy to `.env` and fill in your values:   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# --- Database (async PostgreSQL driver) ---
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
# Matches the docker-compose.yml service in this repo.
DATABASE_URL=postgresql+asyncpg://sales:sales@localhost:5432/sales_insight

# Used by the pytest integration suite. It creates this database itself, so
# the role needs CREATEDB (locally: ALTER ROLE sales CREATEDB;).
TEST_DATABASE_URL=postgresql+asyncpg://sales:sales@localhost:5432/sales_insight_test

# --- JWT authentication ---
# Also signs employee-invitation and password-reset tokens. Keep it secret.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256

# --- Redis (token blocklist + Celery broker/backend) ---
REDIS_URL=redis://localhost:6379/0

# --- Email (used for verification & password-reset messages) ---
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Sales Insight
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# Public domain used when building links inside emails.
DOMAIN=localhost:8000

# --- AI (Claude API) ---
# Get a key at https://console.anthropic.com/
# Leave empty to run in demo mode: insights fall back to a built-in
# heuristic analysis instead of calling the model.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
